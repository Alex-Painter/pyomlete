#!/usr/bin/env bash
# Build, launch, health-check, drive and tear down Omlete on the iOS Simulator
# for verification. See ../SKILL.md for when to use each subcommand.
#
#   omlete-ios-verify up                    start the local API with fixtures, then build, install and launch
#   omlete-ios-verify doctor                read-only: is this instance worth driving?
#   omlete-ios-verify begin <label>         start a new evidence folder for the steps that follow
#   omlete-ios-verify snapshot              print the UI tree; save it and a screenshot
#   omlete-ios-verify expect <text>         wait until <text> is on screen
#   omlete-ios-verify gone <text>           wait until <text> is no longer on screen
#   omlete-ios-verify expect-id <id>        wait until a control with accessibility id <id> exists
#   omlete-ios-verify tap <id> [then <id>]  tap the control with accessibility id <id>, then at once a second one
#   omlete-ios-verify type <id> <text>      replace the contents of field <id> with <text>
#   omlete-ios-verify swipe <id> <dir>      swipe up|down|left|right inside scrollable <id>
#   omlete-ios-verify relaunch              cold-start the installed build: no rebuild, no reseed
#   omlete-ios-verify api stop|start|seed   take the local API away, bring it back, or reset its fixtures
#   omlete-ios-verify down                  stop the app and the local API; shut the simulator down if `up` booted it
set -euo pipefail

SKILL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
IOS="$(cd "$SKILL_DIR/../../.." && pwd)"
ROOT="$(cd "$IOS/.." && pwd)"
RUN_DIR="${OMLETE_IOS_VERIFY_RUN_DIR:-$IOS/.verify-run}"
EVIDENCE_DIR="${OMLETE_IOS_VERIFY_EVIDENCE_DIR:-$IOS/verify-artifacts}"
STATE="$RUN_DIR/state"
BUNDLE_ID=com.alexpainter.omlete
WAIT_MS="${OMLETE_IOS_VERIFY_TIMEOUT_MS:-20000}"

# The app's own local API and database, apart from the web verify skill's
# (8000 and 27018) so both can run at once. 127.0.0.1, never localhost: see
# the root AGENTS.md.
API_PORT="${OMLETE_IOS_VERIFY_API_PORT:-8765}"
API="http://127.0.0.1:$API_PORT"
MONGO_CONTAINER=omlete-ios-verify-mongo
MONGO_IMAGE=mongodb/mongodb-atlas-local:8.0
MONGO_PORT="${OMLETE_IOS_VERIFY_MONGO_PORT:-27019}"
DB_URI_LOCAL="mongodb://127.0.0.1:$MONGO_PORT/?directConnection=true"
FIXTURE_LIST="Verify Fixture List"
FIXTURE_SOURCE="https://example.com/verify-fixture-traybake"

die() { echo "omlete-ios-verify: $*" >&2; exit 1; }
say() { echo "==> $*"; }

# XcodeBuildMCP's CLI reads .xcodebuildmcp/config.yaml from the directory it
# runs in, so every call is made from ios/.
# Resolved to the installed binary once per `up`: going through npx on every
# call adds about a second, which the 5-second Undo banner cannot spare.
xb() {
  local bin; bin="$(cat "$RUN_DIR/xb-path" 2>/dev/null || true)"
  if [ -x "$bin" ]; then (cd "$IOS" && "$bin" "$@"); else (cd "$IOS" && npx -y xcodebuildmcp@latest "$@"); fi
}

pid_alive() { [ -f "$1" ] && kill -0 "$(cat "$1")" 2>/dev/null; }

http_code() { curl -s -o /dev/null -w '%{http_code}' --max-time 3 "$@" || true; }

api() { curl -sf --max-time 10 -H 'Content-Type: application/json' "$@"; }

start_mongo() {
  docker info >/dev/null 2>&1 || die "Docker daemon is not reachable. Start Docker Desktop (or colima) and retry."
  if [ -z "$(docker ps -aq -f "name=^${MONGO_CONTAINER}$")" ]; then
    say "starting $MONGO_IMAGE as $MONGO_CONTAINER on 127.0.0.1:$MONGO_PORT"
    docker run -d --name "$MONGO_CONTAINER" -p "127.0.0.1:$MONGO_PORT:27017" "$MONGO_IMAGE" >/dev/null
  else
    docker start "$MONGO_CONTAINER" >/dev/null
  fi
  local s=""
  for _ in $(seq 1 90); do
    s="$(docker inspect -f '{{.State.Health.Status}}' "$MONGO_CONTAINER" 2>/dev/null || true)"
    [ "$s" = healthy ] && return 0
    sleep 2
  done
  die "mongo container never became healthy (last status: $s); see: docker logs $MONGO_CONTAINER"
}

start_api() {
  [ -x "$ROOT/server/.venv/bin/uvicorn" ] \
    || die "server/.venv is missing; from the repo root run: .claude/skills/verify-omlete/scripts/omlete-verify setup"
  if ! pid_alive "$RUN_DIR/api.pid"; then
    [ "$(http_code "$API/")" = 000 ] \
      || die "$API is already answering and was not started by this skill. Free port $API_PORT or set OMLETE_IOS_VERIFY_API_PORT."
    say "starting API on $API (log: .verify-run/api.log)"
    (
      cd "$ROOT/server"
      # Exported vars win over server/.env, so a production DB_URI there is never used.
      export DB_URI="$DB_URI_LOCAL"
      # Both SDK clients are built at import time; a placeholder lets CRUD work without keys.
      # Placeholders by default, even with real keys in server/.env: the Discover and Add
      # recipes prove failures, and a real key would spend money on every run.
      if [ "${OMLETE_IOS_VERIFY_REAL_KEYS:-0}" != 1 ]; then
        export ANTHROPIC_API_KEY=omlete-verify-no-key VOYAGE_API_KEY=omlete-verify-no-key
      fi
      nohup .venv/bin/uvicorn main:app --host 127.0.0.1 --port "$API_PORT" > "$RUN_DIR/api.log" 2>&1 &
      echo $! > "$RUN_DIR/api.pid"
    )
  fi
  for _ in $(seq 1 60); do
    [ "$(http_code "$API/api/lists/")" = 200 ] && return 0
    pid_alive "$RUN_DIR/api.pid" || { tail -20 "$RUN_DIR/api.log" >&2; die "API exited during startup"; }
    sleep 1
  done
  tail -20 "$RUN_DIR/api.log" >&2; die "API not ready after 60s"
}

stop_api() {
  if pid_alive "$RUN_DIR/api.pid"; then
    local p; p="$(cat "$RUN_DIR/api.pid")"
    kill "$p" 2>/dev/null || true
    for _ in $(seq 1 20); do kill -0 "$p" 2>/dev/null || break; sleep 0.25; done
    kill -9 "$p" 2>/dev/null || true
    say "stopped API (pid $p)"
  fi
  rm -f "$RUN_DIR/api.pid"
}

# Leaves exactly one list, "$FIXTURE_LIST", with two meals: the Shakshuka
# fixture recipe and "Verify Fixture Soft Egg", whose first step holds a
# 5-second timer so a recipe can watch one finish. Plus milk and bananas. The
# list is built through the API so it has the shape the server really produces.
#
# Also leaves "Verify Fixture Traybake", a recipe in the shape a link import
# saves (source, time, rating, ingredient groups, no picture), and five
# Discover cards across four shelves. The last card's link is the Traybake's
# source, so saving it finds that recipe without asking a model.
# Only ever runs against the disposable database.
seed() {
  local py="$ROOT/server/.venv/bin/python"
  "$py" "$ROOT/.claude/skills/verify-omlete/scripts/seed.py" "$DB_URI_LOCAL" >/dev/null
  "$py" - "$DB_URI_LOCAL" "$FIXTURE_SOURCE" <<'PY'
import sys
from datetime import datetime, timezone
from pymongo import MongoClient
from datetime import timedelta
db = MongoClient(sys.argv[1], serverSelectionTimeoutMS=5000)["omlete"]
now = datetime.now(timezone.utc)
def ing(name, unit, amount, category, group=None, note=None, excluded=False):
    return {"name": name, "unit": unit, "amount": amount, "note": note, "group": group,
            "category": category, "excluded_from_list": excluded}
db.recipes.insert_many([
    {
        "title": "Verify Fixture Soft Egg",
        "instructions": ["Boil the egg for 5 seconds.", "Peel it and eat with toast."],
        "ingredients": [ing("eggs", "whole", 1, "Dairy & Eggs")],
        "rating": None,
        "created_at": now,
    },
    {
        "title": "Verify Fixture Traybake",
        "instructions": ["Roast the chicken and potatoes for 40 minutes.", "Whisk the dressing and pour it over."],
        "ingredients": [
            ing("chicken thighs", "whole", 6, "Meat & Fish", group="For the traybake"),
            ing("new potatoes", "grams", 500, "Fresh Produce", group="For the traybake", note="halved"),
            ing("olive oil", "tablespoons", 2, "Pantry & Dry Goods", group="For the dressing", excluded=True),
            ing("lemon", "whole", 1, "Fresh Produce", group="For the dressing"),
        ],
        "rating": 5,
        "servings": 4,
        "total_minutes": 45,
        "source_url": sys.argv[2],
        "source_name": "example.com",
        "created_at": now - timedelta(minutes=2),
    },
])
db.suggestions.delete_many({})
# The server makes the default aisles again the next time they are asked for.
db.user_settings.delete_many({})
# A recipe a run made (saved from a card, or added) is not a fixture: the library starts from the four above.
db.recipes.delete_many({"title": {"$not": {"$regex": "^Verify Fixture "}}})
PY
  api -X POST "$API/api/suggestions/" -d "$(jq -n --arg u "$FIXTURE_SOURCE" '{suggestions: [
    {title: "Verify Card Imported Traybake", reason: "Its page is already in your recipes.", section: "Something new",
     source_url: $u, source_name: "example.com", total_minutes: 45},
    {title: "Verify Card Loose Idea", reason: "A card with no shelf of its own."},
    {title: "Verify Card Quick Noodles", reason: "On the table in twenty minutes.", section: "Under 30 minutes", total_minutes: 20},
    {title: "Verify Card Bean Chilli", reason: "You rated the shakshuka highly.", section: "For this week", total_minutes: 50},
    {title: "Verify Card Miso Aubergine", reason: "Uses the eggs on your list.", section: "For this week", total_minutes: 35,
     source_name: "Chef"}
  ]}')" >/dev/null
  local id
  for id in $(api "$API/api/lists/" | jq -r '.[].id'); do api -X DELETE "$API/api/lists/$id" >/dev/null; done
  id="$(api -X POST "$API/api/lists/" | jq -r .id)"
  api -X PATCH "$API/api/lists/$id" -d "$(jq -n --arg n "$FIXTURE_LIST" '{name: $n}')" >/dev/null
  local title recipe
  for title in "Verify Fixture Shakshuka" "Verify Fixture Soft Egg"; do
    recipe="$(api "$API/api/recipes/" | jq -r --arg t "$title" '[.[] | select(.title == $t)][0].id')"
    api -X POST "$API/api/lists/$id/recipes" -d "$(jq -n --arg r "$recipe" '{recipe_id: $r}')" >/dev/null
  done
  api -X POST "$API/api/lists/$id/items" -d '{"name":"milk","amount":2,"unit":"pint","category":"Dairy & Eggs"}' >/dev/null
  api -X POST "$API/api/lists/$id/items" -d '{"name":"bananas","amount":6,"unit":null,"category":"Fresh Produce"}' >/dev/null
  say "seeded \"$FIXTURE_LIST\" ($id): 6 items, 2 meals; 4 recipes; 5 suggestions"
}

state_get() { [ -f "$STATE" ] || return 0; sed -n "s/^$1=//p" "$STATE" | head -1; }

sim_name() { sed -n 's/^ *simulatorName: *//p' "$IOS/.xcodebuildmcp/config.yaml"; }

# Prints "<udid> <state>" for the pinned simulator.
sim_lookup() {
  xcrun simctl list devices available -j | jq -r --arg n "$(sim_name)" \
    '[.devices[][] | select(.name == $n)][0] | "\(.udid) \(.state)"'
}

sim_state() { xcrun simctl list devices -j | jq -r --arg u "$1" '.devices[][] | select(.udid == $u) | .state'; }

# PID of Omlete on the simulator, or nothing when it is not running.
app_pid() {
  xcrun simctl spawn "$1" launchctl list 2>/dev/null \
    | awk -v b="UIKitApplication:$BUNDLE_ID" 'index($3, b) == 1 && $1 != "-" { print $1 }'
}

# Swift, asset and project files changed since the build `up` made.
stale_sources() { find "$IOS/Omlete" -type f -newer "$RUN_DIR/build.json" -not -path '*/xcuserdata/*' -not -name .DS_Store; }

require_up() {
  [ -f "$STATE" ] || die "no instance started by this skill; run: $0 up"
  UDID="$(state_get udid)"
}

run_dir() {
  local d; d="$(state_get run)"
  if [ -z "$d" ] || [ ! -d "$d" ]; then cmd_begin run >/dev/null; d="$(state_get run)"; fi
  echo "$d"
}

log() { echo "$(date +%H:%M:%S) $*" >> "$(run_dir)/run.log"; }

next_prefix() {
  local d; d="$(run_dir)"
  printf '%s/%02d-%s' "$d" "$(( $(find "$d" -name '*.json' | wc -l) + 1 ))" "$1"
}

# Saves <prefix>.json (UI tree) and <prefix>.jpg, and prints the tree rows.
capture() {
  local prefix; prefix="$(next_prefix "$1")"
  xb ui-automation snapshot-ui --simulator-id "$UDID" --output json > "$prefix.json" \
    || die "UI snapshot failed (see $prefix.json); run: $0 doctor"
  local shot
  shot="$(xb simulator screenshot --simulator-id "$UDID" --output json | jq -r '.data.artifacts.screenshotPath // empty')"
  [ -n "$shot" ] && cp "$shot" "$prefix.jpg"
  echo "ref|action|role|label|value|id"
  jq -r '.data.capture | (.targets[], .scroll[], .text[])' "$prefix.json"
  echo "evidence: ${prefix#$IOS/}.{json,jpg}"
}

# Finds the element whose accessibility identifier is $1 in a fresh snapshot.
ref_for() {
  local ref
  ref="$(xb ui-automation snapshot-ui --simulator-id "$UDID" --output json \
    | jq -r --arg id "$1" '[.data.capture | (.targets[], .scroll[]) | split("|") | select(.[-1] == $id) | .[0]][0] // empty')"
  [ -n "$ref" ] || die "no tappable or scrollable control with accessibility id '$1' on screen; run: $0 snapshot"
  echo "$ref"
}

wait_for() {
  local what="$1"; shift
  if xb ui-automation wait-for-ui --simulator-id "$UDID" --timeout-ms "$WAIT_MS" "$@" > "$RUN_DIR/last-wait.txt" 2>&1; then
    log "PASS $what"; echo "PASS $what"
  else
    log "FAIL $what"; echo "FAIL $what"; capture fail >/dev/null || true
    tail -6 "$RUN_DIR/last-wait.txt" >&2; exit 1
  fi
}

# True when some element's label or value contains $1.
on_screen() {
  xb ui-automation snapshot-ui --simulator-id "$UDID" --output json \
    | jq -e --arg t "$1" '[.data.capture | (.targets[], .scroll[], .text[]) | split("|") | (.[3], .[4]) | select(contains($t))] | length > 0' >/dev/null
}

# Polls the UI tree itself: wait-for-ui's text predicates fail outright when
# the text is in more than one element, which any list row and its title are.
wait_text() {
  local what="$1" want="$2" text="$3" deadline=$(( $(date +%s) + WAIT_MS / 1000 ))
  while :; do
    if on_screen "$text"; then [ "$want" = present ] && break; else [ "$want" = absent ] && break; fi
    if [ "$(date +%s)" -ge "$deadline" ]; then
      log "FAIL $what"; echo "FAIL $what"; capture fail >/dev/null || true; exit 1
    fi
    sleep 0.5
  done
  log "PASS $what"; echo "PASS $what"
}

act() {
  local what="$1"; shift
  if xb "$@" > "$RUN_DIR/last-action.txt" 2>&1; then
    log "PASS $what"; echo "PASS $what"
  else
    log "FAIL $what"; echo "FAIL $what"; tail -8 "$RUN_DIR/last-action.txt" >&2; exit 1
  fi
}

cmd_up() {
  mkdir -p "$RUN_DIR" "$EVIDENCE_DIR"
  local udid before booted_by_us
  read -r udid before <<< "$(sim_lookup)"
  [ -n "$udid" ] && [ "$udid" != null ] || die "no available simulator named '$(sim_name)' (ios/.xcodebuildmcp/config.yaml)"

  # Refuse to double-drive: Omlete already running on the pinned simulator and
  # not launched by us is someone's Xcode or manual session.
  if [ ! -f "$STATE" ] && [ "$before" = Booted ] && [ -n "$(app_pid "$udid")" ]; then
    [ "${OMLETE_IOS_VERIFY_TAKEOVER:-}" = 1 ] || die "Omlete is already running on $(sim_name) and this skill did not launch it.
Stop it in Xcode or the simulator first, or re-run with OMLETE_IOS_VERIFY_TAKEOVER=1 to replace it."
  fi
  booted_by_us="$(state_get booted_by_us)"
  [ -n "$booted_by_us" ] || { [ "$before" = Booted ] && booted_by_us=0 || booted_by_us=1; }

  npx -y -p xcodebuildmcp@latest which xcodebuildmcp > "$RUN_DIR/xb-path" 2>/dev/null || rm -f "$RUN_DIR/xb-path"

  start_mongo
  start_api
  seed

  say "building and launching Omlete on $(sim_name) against $API (log: .verify-run/build.json)"
  xb simulator build-and-run --output json \
      --json "$(jq -nc --arg u "$API" '{launchArgs: ["-apiBaseURL", $u]}')" > "$RUN_DIR/build.json" \
    || { jq -r '.error, .data.diagnostics.errors[]?.message' "$RUN_DIR/build.json" >&2; die "build or launch failed"; }

  printf 'udid=%s\nbooted_by_us=%s\npid=%s\nrun=\n' "$udid" "$booted_by_us" \
    "$(jq -r '.data.artifacts.processId' "$RUN_DIR/build.json")" > "$STATE"
  UDID="$udid"
  xb ui-automation wait-for-ui --simulator-id "$UDID" --predicate settled --timeout-ms "$WAIT_MS" >/dev/null \
    || die "app launched but its UI never answered; run: $0 doctor"
  say "up: Omlete pid $(state_get pid) on $(sim_name) ($udid)"
}

cmd_doctor() {
  local fail=0
  ok()  { echo "ok    $*"; }
  bad() { echo "FAIL  $*"; fail=1; }

  if [ ! -f "$STATE" ]; then bad "no .verify-run/state; run: omlete-ios-verify up"; return 1; fi
  UDID="$(state_get udid)"
  ok "state: $(tr '\n' ' ' < "$STATE")"

  [ "$(sim_state "$UDID")" = Booted ] && ok "simulator $(sim_name) is booted" || bad "simulator $(sim_name) is not booted"

  local pid; pid="$(app_pid "$UDID")"
  if [ -z "$pid" ]; then bad "Omlete is not running on the simulator"
  elif [ "$pid" = "$(state_get pid)" ]; then ok "Omlete pid $pid is the process up launched"
  else bad "Omlete is running as pid $pid, not the pid $(state_get pid) that up launched (crashed and relaunched, or started by Xcode)"; fi

  pid_alive "$RUN_DIR/api.pid" && [ "$(http_code "$API/api/lists/")" = 200 ] \
    && ok "local API answers on $API (pid $(cat "$RUN_DIR/api.pid"))" \
    || bad "local API is not answering on $API; run: omlete-ios-verify api start"
  [ "$(docker inspect -f '{{.State.Health.Status}}' "$MONGO_CONTAINER" 2>/dev/null || true)" = healthy ] \
    && ok "mongo $MONGO_CONTAINER healthy on 127.0.0.1:$MONGO_PORT" || bad "mongo container $MONGO_CONTAINER not healthy"

  local stale; stale="$(stale_sources | head -3)"
  [ -z "$stale" ] && ok "installed build is newer than every file in ios/Omlete" \
    || bad "sources changed since the build; run up again: $(echo "$stale" | sed "s|$IOS/||" | tr '\n' ' ')"

  local n
  n="$(xb ui-automation snapshot-ui --simulator-id "$UDID" --output json 2>/dev/null | jq -r 'select(.didError == false) | .data.capture.count' || true)"
  [ -n "$n" ] && [ "$n" -gt 0 ] && ok "UI tree answers ($n elements)" || bad "UI snapshot failed: the app is not on screen or accessibility is unreachable"
  return $fail
}

cmd_begin() {
  [ $# -eq 1 ] || die "usage: omlete-ios-verify begin <label>"
  require_up
  local d; d="$EVIDENCE_DIR/$(date +%Y%m%d-%H%M%S)-$1"
  mkdir -p "$d"
  sed -i '' "s|^run=.*|run=$d|" "$STATE"
  echo "$(date +%H:%M:%S) begin $1 (pid $(state_get pid), $(git -C "$IOS" rev-parse --short HEAD))" > "$d/run.log"
  echo "${d#$IOS/}"
}

cmd_snapshot() { require_up; capture snapshot; }

cmd_expect() {
  [ $# -eq 1 ] || die "usage: omlete-ios-verify expect <text>"
  require_up; wait_text "expect \"$1\"" present "$1"; capture expect >/dev/null
}

cmd_gone() {
  [ $# -eq 1 ] || die "usage: omlete-ios-verify gone <text>"
  require_up; wait_text "gone \"$1\"" absent "$1"; capture gone >/dev/null
}

cmd_expect_id() {
  [ $# -eq 1 ] || die "usage: omlete-ios-verify expect-id <accessibility id>"
  require_up; wait_for "expect-id $1" --predicate exists --identifier "$1"; capture expect-id >/dev/null
}

# `then <id>` taps a second control straight after the first, with no evidence
# capture in between: a capture takes about as long as the Undo banner lasts.
cmd_tap() {
  [ $# -eq 1 ] || { [ $# -eq 3 ] && [ "$2" = then ]; } || die "usage: omlete-ios-verify tap <accessibility id> [then <accessibility id>]"
  require_up
  local ref; ref="$(ref_for "$1")"
  act "tap $1" ui-automation tap --simulator-id "$UDID" --element-ref "$ref"
  if [ $# -eq 3 ]; then
    ref="$(ref_for "$3")"
    act "tap $3" ui-automation tap --simulator-id "$UDID" --element-ref "$ref"
  fi
  capture tap >/dev/null
}

cmd_type() {
  [ $# -eq 2 ] || die "usage: omlete-ios-verify type <accessibility id> <text>"
  require_up
  local ref; ref="$(ref_for "$1")"
  act "type $1 \"$2\"" ui-automation type-text --simulator-id "$UDID" --element-ref "$ref" --text "$2" --replace-existing
  capture type >/dev/null
}

cmd_swipe() {
  [ $# -eq 2 ] || die "usage: omlete-ios-verify swipe <accessibility id> up|down|left|right"
  require_up
  local ref; ref="$(ref_for "$1")"
  act "swipe $1 $2" ui-automation swipe --simulator-id "$UDID" --within-element-ref "$ref" --direction "$2"
  capture swipe >/dev/null
}

# Cold start of the installed build: no rebuild, no reseed, API left as it is.
cmd_relaunch() {
  require_up
  xb simulator stop --simulator-id "$UDID" --bundle-id "$BUNDLE_ID" >/dev/null 2>&1 || true
  xb simulator launch-app --simulator-id "$UDID" --bundle-id "$BUNDLE_ID" --output json \
      --json "$(jq -nc --arg u "$API" '{launchArgs: ["-apiBaseURL", $u]}')" > "$RUN_DIR/launch.json" \
    || die "relaunch failed (see .verify-run/launch.json)"
  xb ui-automation wait-for-ui --simulator-id "$UDID" --predicate settled --timeout-ms "$WAIT_MS" >/dev/null \
    || die "app relaunched but its UI never answered; run: $0 doctor"
  sed -i '' "s|^pid=.*|pid=$(app_pid "$UDID")|" "$STATE"
  say "relaunched: Omlete pid $(state_get pid)"
}

cmd_api() {
  case "${1:-}" in
    stop)  stop_api ;;
    start) mkdir -p "$RUN_DIR"; start_mongo; start_api; say "API answers on $API" ;;
    seed)  seed ;;
    *) die "usage: omlete-ios-verify api stop|start|seed" ;;
  esac
}

cmd_down() {
  stop_api
  if docker info >/dev/null 2>&1 && [ -n "$(docker ps -aq -f "name=^${MONGO_CONTAINER}$")" ]; then
    docker rm -f "$MONGO_CONTAINER" >/dev/null && say "removed $MONGO_CONTAINER (disposable data)"
  fi
  if [ ! -f "$STATE" ]; then say "no app instance to stop"; return 0; fi
  UDID="$(state_get udid)"
  # Only the instance up launched: a different pid belongs to someone else.
  if [ "$(app_pid "$UDID")" = "$(state_get pid)" ]; then
    xb simulator stop --simulator-id "$UDID" --bundle-id "$BUNDLE_ID" >/dev/null 2>&1 && say "stopped Omlete (pid $(state_get pid))"
  fi
  if [ "$(state_get booted_by_us)" = 1 ] && [ "$(sim_state "$UDID")" = Booted ]; then
    xcrun simctl shutdown "$UDID" && say "shut down $(sim_name), which up had booted"
  fi
  rm -f "$STATE" "$RUN_DIR/last-wait.txt" "$RUN_DIR/last-action.txt"
  say "down. evidence kept in ${EVIDENCE_DIR#$IOS/}/"
}

sub="${1:-}"; shift || true
case "$sub" in
  up)        cmd_up "$@" ;;
  doctor)    cmd_doctor "$@" ;;
  begin)     cmd_begin "$@" ;;
  snapshot)  cmd_snapshot "$@" ;;
  expect)    cmd_expect "$@" ;;
  gone)      cmd_gone "$@" ;;
  expect-id) cmd_expect_id "$@" ;;
  tap)       cmd_tap "$@" ;;
  type)      cmd_type "$@" ;;
  swipe)     cmd_swipe "$@" ;;
  relaunch)  cmd_relaunch "$@" ;;
  api)       cmd_api "$@" ;;
  down)      cmd_down "$@" ;;
  *) sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
